// Prisma schema for the P2P marketplace.
//
// Lives at the repository root per AGENTS.md. The Prisma CLI is run from
// `server/` and configured by `server/prisma.config.ts`.
//
// Scope: the identity slice needed by Phases 1 and 2. `PhoneOtp` (chunk 8) is
// added with its own migration when that chunk lands. `Profile` arrived with
// chunk 7. Listings, categories, and listing lifecycle states arrive with
// chunk 9. Listing images arrive with chunk 10.

generator client {
  provider            = "prisma-client"
  output              = "../server/src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  EMAIL_CHANGE
  PHONE_VERIFY
}

/// Account and credential record. Public profile data lives in `Profile` (chunk 7).
model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String     @map("password_hash")
  role            UserRole   @default(USER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  /// E.164 format. Unique so one phone number cannot verify several accounts.
  phoneE164       String?    @unique @map("phone_e164")
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  /// Set when the seller has completed gateway payout onboarding.
  payoutOnboardedAt DateTime? @map("payout_onboarded_at") @db.Timestamptz(3)
  /// Gateway's connected-account id, never returned to clients.
  payoutAccountId   String?   @map("payout_account_id") @db.VarChar(200)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions   Session[]
  authTokens AuthToken[]
  profile    Profile?
  listings   Listing[]
  /// Deals where this user is the buyer (the proposer).
  boughtDeals Deal[] @relation("BuyerDeals")
  /// Deals where this user is the seller (the listing owner).
  soldDeals   Deal[] @relation("SellerDeals")
  /// Actors recorded in deal history.
  dealEvents DealHistory[]
  /// Messages authored by this user in deal threads.
  dealMessages DealMessage[]

  @@map("users")
}

/// How a deal is to be settled. Exchange offers get their offered listings in
/// a later chunk; for now only SALE proposals exist.
enum DealType {
  SALE
  EXCHANGE
}

/// Explicit deal lifecycle. The state machine in code is the only place that
/// decides which transitions are legal; this enum lists every state so later
/// chunks can add transitions without a schema migration.
enum DealStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  CANCELLED
  PAYMENT_PENDING
  COMPLETED
  DISPUTED
  RESOLVED
}

/// A proposal from a buyer to a seller over one listing. The deal record IS the
/// proposal: its initial status is PROPOSED and it moves through the state
/// machine. Only one deal per listing may be ACCEPTED at a time (enforced by a
/// partial unique index in the migration).
model Deal {
  id         String     @id @default(uuid()) @db.Uuid
  listingId  String     @map("listing_id") @db.Uuid
  buyerId    String     @map("buyer_id") @db.Uuid
  sellerId   String     @map("seller_id") @db.Uuid
  type       DealType   @default(SALE) @map("type")
  amountCents Int?      @map("amount_cents") // Offer price; null for exchange-only
  status     DealStatus @default(PROPOSED) @map("status")
  /// When secured funds are automatically refunded if handoff never happens.
  escrowExpiresAt DateTime? @map("escrow_expires_at") @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer   User    @relation("BuyerDeals", fields: [buyerId], references: [id], onDelete: Cascade)
  seller  User    @relation("SellerDeals", fields: [sellerId], references: [id], onDelete: Cascade)
  history DealHistory[]
  /// Listings the proposer offers in an exchange deal (their own items).
  offeredListings DealOfferedListing[]
  /// Messages between the two participants for arranging the handoff.
  messages DealMessage[]
  /// Payment transactions for this deal.
  transactions Transaction[]

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@map("deals")
}

/// A listing the buyer offers as part of an exchange proposal. The listing
/// being proposed on is stored on Deal.listingId; these are the proposer's own
/// items offered in return. All of them are reserved when the deal is accepted.
model DealOfferedListing {
  id        String @id @default(uuid()) @db.Uuid
  dealId    String @map("deal_id") @db.Uuid
  listingId String @map("listing_id") @db.Uuid

  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([dealId, listingId])
  @@index([listingId])
  @@map("deal_offered_listings")
}

/// Append-only audit of every deal state transition, with actor and timestamp.
model DealHistory {
  id         String      @id @default(uuid()) @db.Uuid
  dealId     String      @map("deal_id") @db.Uuid
  actorId    String?     @map("actor_id") @db.Uuid
  fromStatus DealStatus  @map("from_status")
  toStatus   DealStatus  @map("to_status")
  note       String?     @map("note")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  deal  Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([dealId])
  @@map("deal_history")
}

/// A message in a deal's thread. Only the deal's buyer and seller can read or
/// write messages, enforced in the service layer.
model DealMessage {
  id        String   @id @default(uuid()) @db.Uuid
  dealId    String   @map("deal_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  body      String   @map("body") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  deal   Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([dealId, createdAt])
  @@map("deal_messages")
}

/// The lifecycle of a payment for a sale deal. All amounts are integer minor
/// units (cents) with an explicit currency; no floating point money.
enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Transaction {
  id              String            @id @default(uuid()) @db.Uuid
  dealId          String            @map("deal_id") @db.Uuid
  provider        String            @map("provider") @db.VarChar(50)
  providerPaymentId String          @unique @map("provider_payment_id") @db.VarChar(200)
  amountCents     Int               @map("amount_cents")
  feeCents        Int               @default(0) @map("fee_cents")
  currency        String            @default("USD") @map("currency") @db.VarChar(3)
  status          TransactionStatus @default(PENDING) @map("status")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]

  @@index([dealId])
  @@index([status])
  @@map("transactions")
}

/// Ledger of money movements (holds, refunds, payouts). Append-only; each
/// entry references a transaction and records the direction and amount.
enum LedgerEntryType {
  HOLD
  REFUND
  PAYOUT
}

model LedgerEntry {
  id            String         @id @default(uuid()) @db.Uuid
  transactionId String         @map("transaction_id") @db.Uuid
  type          LedgerEntryType @map("type")
  amountCents   Int            @map("amount_cents")
  currency      String         @default("USD") @map("currency") @db.VarChar(3)
  reference     String?        @map("reference") @db.VarChar(200)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("ledger_entries")
}

/// A processed gateway webhook event. The unique provider_event_id makes
/// handlers idempotent: a replayed event is recorded once and ignored.
model WebhookEvent {
  id               String   @id @default(uuid()) @db.Uuid
  providerEventId  String   @unique @map("provider_event_id") @db.VarChar(200)
  provider         String   @map("provider") @db.VarChar(50)
  type             String   @map("type") @db.VarChar(100)
  payload          Json     @map("payload")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("webhook_events")
}

/// Public profile data, split from `User` so a public read can never select the
/// email or password hash by accident. One row per account, created with it.
/// Avatar upload arrives in chunk 10; until then the UI draws initials.
model Profile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  displayName String   @default("") @map("display_name") @db.VarChar(60)
  bio         String   @default("") @db.VarChar(500)
  location    String   @default("") @db.VarChar(80)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

/// Refresh-token session. Stores only a hash of the opaque refresh token.
/// `familyId` groups every token descended from one login so reuse detection
/// can revoke the whole family.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single-use, hashed action token for email verification, password reset, and
/// (chunk 7) email change. `payload` carries token-specific data such as the
/// pending new address for EMAIL_CHANGE.
model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(3)
  payload   Json?
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

/// How a listing can be transacted: sale for money, exchange for other
/// listings, or both.
enum ListingType {
  SALE
  EXCHANGE
  BOTH
}

/// The condition of the listed item, chosen by the seller.
enum ListingCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

/// The lifecycle state of a listing. Drafts are invisible to other members;
/// active listings can receive proposals; reserved/sold/exchanged/removed are
/// terminal or intermediate deal states.
enum ListingStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD
  EXCHANGED
  REMOVED
}

/// A category groups similar listings (e.g. "Electronics", "Furniture").
/// Slugs are unique and used in URLs and filters.
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @map("name") @db.VarChar(100)
  slug      String   @unique @map("slug") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  listings Listing[]

  @@map("categories")
}

/// An item a member offers for sale or exchange. Owned by one user, optionally
/// categorized, and always in one of the explicit lifecycle statuses.
model Listing {
  id          String        @id @default(uuid()) @db.Uuid
  ownerId     String        @map("owner_id") @db.Uuid
  categoryId  String?       @map("category_id") @db.Uuid
  title       String        @map("title") @db.VarChar(200)
  description String        @map("description") @db.Text
  condition   ListingCondition @default(GOOD) @map("condition")
  priceCents  Int?          @map("price_cents") // Nullable: exchange-only listings have no price
  listingType ListingType   @default(BOTH) @map("listing_type")
  status      ListingStatus @default(DRAFT) @map("status")
  location    String        @map("location") @db.VarChar(200)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  images      ListingImage[]
  deals       Deal[]
  offeredInDeals DealOfferedListing[]
  owner    User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Full-text search vector maintained by PostgreSQL (see migration). Kept as
  /// Unsupported so Prisma does not try to manage the generated column.
  searchVector Unsupported("tsvector")? @map("search_vector")

  @@index([ownerId])
  @@index([categoryId])
  @@index([status])
  @@index([listingType])
  @@index([condition])
  @@index([createdAt])
  @@index([priceCents])
  @@map("listings")
}

/// An image attached to a listing. Stored in S3-compatible object storage;
/// the `key` identifies the object, and `url` is the public CDN URL.
model ListingImage {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  key       String   @map("key") @db.VarChar(500) // S3 object key
  url       String   @map("url") @db.VarChar(1000) // Public CDN URL
  mimeType  String   @map("mime_type") @db.VarChar(100)
  sizeBytes Int      @map("size_bytes")
  width     Int?     @map("width")
  height    Int?     @map("height")
  position  Int      @map("position") @default(0) // Display order within the listing
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_images")
}
