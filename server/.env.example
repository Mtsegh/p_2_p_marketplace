NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
TEST_DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace_test
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# console logs emails to the API output (local development); brevo delivers them.
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@marketplace.test
EMAIL_FROM_NAME=P2P Marketplace
# Required when EMAIL_PROVIDER=brevo. Create a key in Brevo under SMTP & API.
BREVO_API_KEY=

# console logs SMS to the API output (local development); memory captures them for tests.
SMS_PROVIDER=console

# Object storage for listing images. `memory` keeps uploads in RAM for tests;
# `s3` uploads to an S3-compatible bucket.
STORAGE_PROVIDER=memory
S3_BUCKET=marketplace-images
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=
S3_PRESIGN_TTL_SECONDS=900

# Shared secret for verifying payment webhook signatures (change in production).
WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
# Days a secured payment is held before automatic refund.
ESCROW_WINDOW_DAYS=7
# Platform fee in basis points (100 = 1%). Zero in test mode.
PLATFORM_FEE_BPS=0
# Secret for the internal escrow-expiry processor endpoint (change in production).
CRON_SECRET=replace-with-a-long-random-cron-secret
# Minutes a handoff code stays valid, and max wrong-code attempts.
HANDOFF_CODE_TTL_MINUTES=60
HANDOFF_MAX_ATTEMPTS=5
